# Generate with: npx auth secret
AUTH_SECRET=

# Slack app credentials (https://api.slack.com/apps -> OAuth & Permissions)
# User Token Scopes needed for "Sign in with Slack": openid, email, profile
# Redirect URL: https://<your-domain>/api/auth/callback/slack
AUTH_SLACK_ID=
AUTH_SLACK_SECRET=

# Only needed locally / behind a proxy. Vercel sets this up automatically.
# AUTH_URL=https://your-tunnel.ngrok-free.app
